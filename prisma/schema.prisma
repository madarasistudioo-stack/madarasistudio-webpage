// Prisma schema for Madarasi Studio.
// Run `npx prisma migrate dev --name init` locally once DATABASE_URL is set,
// or `npx prisma migrate deploy` in your Vercel build step.

generator client {
  provider        = "prisma-client-js"
  // Rust-free client talking to Neon over HTTP/WebSockets, so it runs on
  // Cloudflare Workers (no native query engine binary).
  previewFeatures = ["driverAdapters", "queryCompiler"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Standard NextAuth models -----------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  blocked       Boolean   @default(false)
  tags          String[]  @default([])
  notes         CustomerNote[]
  tickets       SupportTicket[]
  createdAt     DateTime  @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Madarasi-specific models -------------------------------------------

// Short-lived one-time codes sent to a phone number during sign-in.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Order {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           Json
  personalisation Json?
  totalPaise      Int
  currency        String   @default("INR")
  status          String   @default("created") // created | paid | printing | shipped | delivered | cancelled | refunded | failed
  razorpayOrderId String?
  paymentMethod   String   @default("upi") // upi | razorpay
  paymentRef      String? // UPI transaction id or Razorpay payment id
  customerName    String?
  email           String?
  phone           String?
  address         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([createdAt])
}

// Admin overrides layered on the code catalogue (src/lib/products.ts):
// price changes, stock levels and hiding a product, without a redeploy.
model ProductSetting {
  slug      String   @id
  price     Int?
  compareAt Int?
  stock     Int? // null = made to order (unlimited); 0 = sold out
  hidden    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// First-party analytics: page views, searches, add-to-bag and sign-ins.
model Event {
  id        String   @id @default(cuid())
  type      String // pageview | add_to_cart | signin
  path      String?
  detail    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}

// --- CRM ------------------------------------------------------------------

// Private admin notes on a customer.
model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

// Newsletter sign-ups and anyone who got in touch before buying.
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  source    String // newsletter | contact | checkout
  status    String   @default("new") // new | contacted | converted | unsubscribed
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Messages from the Contact page, with the admin's replies.
model SupportTicket {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  phone     String?
  orderRef  String?
  subject   String
  status    String          @default("open") // open | replied | closed
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())
}
